import("//build/config/sanitizers/sanitizers.gni")
import("//build/toolchain/toolchain.gni")

# This is included by reference in the //build/config/compiler config that
# is applied to all targets. It is here to separate out the logic.

config("compiler") {
  _nanvix_toolchain = getenv("NANVIX_TOOLCHAIN")
  _nanvix_sysroot = "${_nanvix_toolchain}/i686-nanvix"

  # These flags are shared between the C compiler and linker.
  defines = [
    "_ALL_SOURCE=1",
    "_POSIX_C_SOURCE=200809L",
    "__nanvix__",
    "V8_OS_NANVIX",
  ]

  cflags = [
    "--sysroot=${_nanvix_sysroot}",

    # The Nanvix cross-compiler does not automatically add the sysroot's
    # include directory to the system header search path. We use -idirafter
    # so that the sysroot's C headers (pthread.h, sched.h, sys/types.h, etc.)
    # are found but placed AFTER the C++ standard library headers, avoiding
    # libc++'s wrapper headers (e.g. <cstring> -> <string.h>) from resolving
    # to the wrong header.
    "-idirafter",
    "${_nanvix_sysroot}/include",
  ]
  cflags_cc = []
  ldflags = []


  # Linker flags
  ldflags += [
    "-m32",  # Ensure 32-bit mode
    "--sysroot=${_nanvix_sysroot}",
  ]
}

config("compiler_codegen") {
  cflags = []

  if (current_cpu == "x86") {
    cflags += [
      # Nanvix supports i686 processors with SSE and SSE2 features.
      "-m32",
      "-march=i686",
      "-msse",
      "-msse2",

      # The following vector extensions are not available on i686 processors.
      # Still, we explicitly disable them, to avoid avoid compiling unsupported
      # code paths in third-party libraries (e.g. Highway).
      "-mno-sse3",
      "-mno-sse4",
      "-mno-sse4.1",
      "-mno-sse4.2",
      "-mno-avx",
      "-mno-avx2",

      # We use the following flags to improve our debugging experience.
      "-fasynchronous-unwind-tables",
      "-mstackrealign",
    ]
  }

  asmflags = cflags
}
