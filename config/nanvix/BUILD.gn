import("//build/config/sanitizers/sanitizers.gni")
import("//build/toolchain/toolchain.gni")

# This is included by reference in the //build/config/compiler config that
# is applied to all targets. It is here to separate out the logic.

config("compiler") {
  # These flags are shared between the C compiler and linker.
  defines = [
    "_ALL_SOURCE=1",
    "__nanvix__",
    "__DISABLE_SSE__",
    "__DISABLE_SSE2__",
    "__DISABLE_SSE3__",
    "V8_OS_NANVIX",
    "_LIBCPP_HAS_NO_LONG_DOUBLE_MATH",
  ]

  cflags = []
  cflags_cc = []
  ldflags = []

  # Nanvix doesn't support SSE instructions, which can cause invalid opcode exceptions
  if (current_cpu == "x86" || current_cpu == "x86_64") {
    cflags += [
      "-m32",  # Ensure 32-bit mode for compatibility

      # Use older architecture that predates SSE
      "-march=i586",
      
      # Explicitly disable all SSE variants
      "-mno-sse",
      "-mno-sse2",
      "-mno-sse3",
      "-mno-ssse3",
      "-mno-sse4",
      "-mno-sse4.1",
      "-mno-sse4.2",
      "-mno-avx",
      "-mno-avx2",
      
      # Math flags for x87 FPU
      "-mfpmath=387",
      
      # Ensure stack alignment for older CPUs
      "-mstackrealign",
      
      # Generate unwind tables for debugging without SSE
      "-fasynchronous-unwind-tables",
    ]
    
    # Apply same flags to C++
    cflags_cc += [
      "-Wno-format",
      "-fno-exceptions",  # Nanvix doesn't support C++ exceptions
      "-fno-rtti",
    ]
    
    # Linker flags
    ldflags += [
      "-m32",  # Ensure 32-bit mode
    ]
  }
}